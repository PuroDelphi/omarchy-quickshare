# Build with scripts/build-package.sh from a source checkout.
pkgname=omarchy-quickshare
pkgver=0.3.7
pkgrel=1
pkgdesc='Quick Share Rust backend for the native Omarchy plugin'
url='https://github.com/PuroDelphi/omarchy-quickshare'
arch=('x86_64' 'aarch64')
license=('MIT' 'GPL-3.0-only')
# NetworkManager's shared IPv4 method starts its own dnsmasq; do not enable dnsmasq.service.
depends=('bluez' 'dbus' 'networkmanager' 'dnsmasq' 'xdg-desktop-portal' 'quickshell' 'omarchy' 'jq' 'nautilus' 'nautilus-python' 'python' 'python-gobject' 'gtk4')
makedepends=('rust' 'cargo' 'protobuf' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
# The builder materializes the actual archive digest in the distributable PKGBUILD.
sha256sums=("${QUICKSHARE_SOURCE_SHA256:?Use scripts/build-package.sh}")
[[ ${sha256sums[0]} =~ ^[[:xdigit:]]{64}$ ]] || {
  printf 'Se requiere SHA-256 real del archivo fuente; usa scripts/build-package.sh.\n' >&2
  exit 1
}

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  RUSTC=/usr/bin/rustc /usr/bin/cargo fetch --locked
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  RUSTC=/usr/bin/rustc /usr/bin/cargo build --release --locked --offline --target-dir target --package omarchy-quickshare
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/omarchy-quickshare "$pkgdir/usr/bin/omarchy-quickshare"
  install -Dm644 packaging/omarchy-quickshare.service "$pkgdir/usr/lib/systemd/user/omarchy-quickshare.service"
  install -Dm644 packaging/system-binary.conf "$pkgdir/usr/lib/systemd/user/omarchy-quickshare.service.d/binary.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 vendor/rquickshare/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-GPL"
  install -Dm644 vendor/rquickshare/LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  install -Dm644 vendor/rquickshare/LICENSE-CHROMIUM "$pkgdir/usr/share/licenses/$pkgname/LICENSE-CHROMIUM"
  install -Dm644 vendor/rquickshare/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 vendor/THIRD_PARTY_NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.txt"
  install -Dm644 vendor/mdns-sd/LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MDNS-MIT"
  install -Dm644 vendor/mdns-sd/LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MDNS-APACHE"
  install -Dm644 vendor/mdns-sd/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE-MDNS"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 preview.png "$pkgdir/usr/share/doc/$pkgname/preview.png"
  install -Dm644 "$startdir/$pkgname-$pkgver.tar.gz" "$pkgdir/usr/share/doc/$pkgname/source/source.tar.gz"
  install -Dm644 docs/VERIFICATION.md "$pkgdir/usr/share/doc/$pkgname/docs/VERIFICATION.md"
  install -Dm644 docs/USER_GUIDE.md "$pkgdir/usr/share/doc/$pkgname/docs/USER_GUIDE.md"
  install -Dm644 docs/INSTALLATION.md "$pkgdir/usr/share/doc/$pkgname/docs/INSTALLATION.md"
  install -Dm644 docs/ARCHITECTURE.md "$pkgdir/usr/share/doc/$pkgname/docs/ARCHITECTURE.md"
  install -Dm644 docs/assets/paypal-qr.png "$pkgdir/usr/share/doc/$pkgname/docs/assets/paypal-qr.png"
  install -d -m755 "$pkgdir/usr/share/doc/$pkgname/docs/assets/screenshots"
  install -m644 docs/assets/screenshots/*.png "$pkgdir/usr/share/doc/$pkgname/docs/assets/screenshots/"
  install -Dm644 CONTRIBUTING.md "$pkgdir/usr/share/doc/$pkgname/CONTRIBUTING.md"
  install -Dm644 CODE_OF_CONDUCT.md "$pkgdir/usr/share/doc/$pkgname/CODE_OF_CONDUCT.md"
  install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
}
